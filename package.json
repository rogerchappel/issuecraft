{
  "name": "issuecraft",
  "version": "0.1.0",
  "description": "Offline GitHub issue draft builder for turning local evidence into reviewable Markdown issues.",
  "type": "module",
  "bin": {
    "issuecraft": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "github",
    "issues",
    "cli",
    "offline",
    "qa",
    "developer-tools"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/issuecraft.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/issuecraft/issues"
  },
  "homepage": "https://github.com/rogerchappel/issuecraft#readme"
}
